{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "webview/src/**/*.ts",
    "webview/src/**/*.tsx",
    "webview/dev/**/*.ts",
    "webview/dev/**/*.mts"
  ]
}
