{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "webview/src/**/*.ts",
    "webview/src/**/*.tsx",
    "vitest.config.mts",
    "vite.config.mts",
    "scripts/check-release.mjs"
  ]
}
