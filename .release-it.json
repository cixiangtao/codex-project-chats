{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commit": false,
    "tag": false,
    "push": false,
    "requireCleanWorkingDir": true,
    "requireUpstream": false
  },
  "npm": false,
  "github": {
    "release": false
  },
  "gitlab": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md"
    },
    "@release-it/bumper": {
      "in": "package.json",
      "out": [
        "package.json",
        {
          "file": "src/client.ts",
          "type": "text/plain"
        }
      ]
    }
  },
  "hooks": {
    "before:init": "pnpm run release:check",
    "after:release": "pnpm run release:check"
  }
}
