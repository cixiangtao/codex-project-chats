{
  "name": "codex-project-chats",
  "displayName": "Codex Project Chats",
  "description": "Browse Codex conversations by project and continue in the official Codex sidebar.",
  "private": true,
  "version": "1.1.0",
  "publisher": "cixiangtao",
  "license": "MIT",
  "icon": "media/icon.png",
  "preview": false,
  "keywords": ["codex", "projects", "history", "conversations", "cwd"],
  "engines": { "vscode": "^1.100.0", "node": "^24.15.0 || >=26.0.0" },
  "repository": { "type": "git", "url": "https://github.com/cixiangtao/codex-project-chats.git" },
  "homepage": "https://github.com/cixiangtao/codex-project-chats#readme",
  "bugs": { "url": "https://github.com/cixiangtao/codex-project-chats/issues" },
  "categories": ["AI", "Chat"],
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "extensionDependencies": ["openai.chatgpt"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": false },
  "activationEvents": ["onView:codexProjectChats.list"],
  "files": ["package.nls*.json", "dist/**", "media/**", "README.md", "README.zh-CN.md", "CHANGELOG.md", "SUPPORT.md", "LICENSE"],
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build",
    "preview": "pnpm run build && node test/preview.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:prepare": "release-it",
    "release:dry": "release-it --dry-run",
    "release:verify": "python3 scripts/marketplace.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "~5.9.0",
    "vitest": "5.0.5",
    "release-it": "21.1.1",
    "@release-it/bumper": "8.0.1",
    "@release-it/conventional-changelog": "12.0.2"
  },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "codexProjectChats", "title": "%viewContainer.title%", "icon": "media/projects.svg" }] },
    "views": { "codexProjectChats": [{ "type": "webview", "id": "codexProjectChats.list", "name": "%view.title%", "contextualTitle": "Codex Project Chats" }] },
    "commands": [
      { "command": "codexProjectChats.open", "title": "%command.open%", "category": "Codex Project Chats" },
      { "command": "codexProjectChats.refresh", "title": "%command.refresh%", "category": "Codex Project Chats", "icon": "$(refresh)" }
    ],
    "menus": { "view/title": [{ "command": "codexProjectChats.refresh", "when": "view == codexProjectChats.list", "group": "navigation" }] },
    "configuration": {
      "title": "Codex Project Chats",
      "properties": {
        "codexProjectChats.cliPath": { "type": "string", "default": "", "scope": "machine", "description": "%configuration.cliPath%" }
      }
    }
  }
}
